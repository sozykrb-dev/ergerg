{%- comment -%}
  THE RACK — clothes hung around a rail.

  A rail with clothes on it, seen from standing height: the rail is an ellipse,
  the pieces stand at angles around it, and the one at the front is the largest
  and the only one at full opacity. Scrolling or dragging turns it, and the ring
  comes all the way round.

  Why not CSS 3D: an earlier version placed the pieces with
  `rotateY(angle) translateZ(radius)` inside a stage with `perspective`. That
  reads correctly on paper and is wrong on screen — `perspective` projects the
  child, so a piece pushed out by translateZ is magnified by P/(P−Z) as well as
  turned. The front piece arrived at twice its width and the neighbours were
  clipped by the screen; it looked like a pile of cards, not a rack. Here the
  depth is in the numbers: x from sin, size and opacity from cos, and the
  rail's width is a variable that can simply be made to fit a phone.

  On a phone the panel is pinned under the header for one turn's worth of
  scrolling, so the screen holds still and the clothes are what move.

  Parameters
    products  the array to hang (required)
    eyebrow   optional small line above the rack
    heading   optional heading; omit inside the collection view
{%- endcomment -%}
{%- assign rack_garments = products | where: 'available', true -%}
{%- assign rack_shown = 0 -%}

<div class="mf-rack" data-rack data-rail>
  {%- if heading != blank or eyebrow != blank -%}
    <header class="mf-rack__head">
      {%- if eyebrow != blank -%}<p class="mf-eyebrow">{{ eyebrow }}</p>{%- endif -%}
      {%- if heading != blank -%}<h2>{{ heading }}</h2>{%- endif -%}
    </header>
  {%- endif -%}

  <div class="mf-rack__stage" data-rack-stage>
    {%- comment -%} the far half of the rail, drawn under the clothes {%- endcomment -%}
    <span class="mf-rack__rail mf-rack__rail--back" aria-hidden="true"></span>

    <ul class="mf-rack__list" data-rack-list>
      {%- for product in rack_garments -%}
        {%- assign slot = product.metafields.molfet.slot.value | default: 'top' -%}
        {%- if slot == 'accessory' -%}{%- continue -%}{%- endif -%}
        {%- assign rack_shown = rack_shown | plus: 1 -%}
        <li class="mf-rack__item" data-rack-item data-slot="{{ slot }}"
          {%- unless request.design_mode %} style="--x: {{ rack_shown | minus: 1 }}; --s: 1"{% endunless %}>
          <span class="mf-rack__hang" aria-hidden="true"></span>
          <a class="mf-rack__figure" href="{{ product.url }}"
            tabindex="-1" aria-hidden="true">
            {%- assign cutout = product.metafields.molfet.cutout -%}
            {%- if cutout != blank -%}
              <img class="mf-rack__img"
                src="{{ cutout | image_url: width: 600 }}"
                alt="{{ product.title | escape }}"
                width="600" height="800"
                loading="lazy" draggable="false">
            {%- elsif product.featured_image != blank -%}
              <img class="mf-rack__img"
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.title | escape }}"
                width="600" height="800"
                loading="lazy" draggable="false">
            {%- else -%}
              <span class="mf-rack__ghost"><b>{{ rack_shown }}</b></span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- comment -%} the near half of the rail, drawn over the clothes {%- endcomment -%}
    <span class="mf-rack__rail mf-rack__rail--front" aria-hidden="true"></span>
  </div>

  {%- if rack_shown == 0 -%}
    <p class="mf-rack__empty">{{ 'rack.empty' | t }}</p>
  {%- endif -%}

  {%- comment -%}
    The front piece, in words. One real link — the figures themselves are out of
    the focus order, so a screen reader (and the thumb on a phone) gets one
    target that names the piece rather than a pile of anonymous links.
  {%- endcomment -%}
  <div class="mf-rack__hud">
    <p class="mf-rack__count" aria-live="polite">
      <span data-rack-index>01</span> / <span data-rack-total>{{ rack_shown }}</span>
    </p>
    <a class="mf-rack__title" href="#" data-rack-front>{{ 'rack.title' | t }}</a>
    <p class="mf-rack__price" data-rack-price></p>
  </div>

  <div class="mf-rack__controls">
    <button type="button" class="mf-rack__step" data-rack-prev
      aria-label="{{ 'rack.previous' | t }}">
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <span class="mf-rack__dots" data-rack-dots aria-hidden="true"></span>

    <button type="button" class="mf-rack__step" data-rack-next
      aria-label="{{ 'rack.next' | t }}">
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  {%- unless request.design_mode -%}
    <div class="mf-rack__span" aria-hidden="true"></div>
  {%- endunless -%}
</div>
