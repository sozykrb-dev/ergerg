{%- comment -%}
  Product: gallery with the Lens, detail hotspots, the made badge, size guide,
  Mix it module, sticky add-to-cart on mobile and accordions.
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign sketch = product.metafields.molfet.sketch_image -%}
{%- assign macro = product.metafields.molfet.macro_image -%}

<section class="mf-product" data-product-id="{{ product.id }}"
  data-money-format="{{ shop.money_format | escape }}">
  <div class="mf-product__inner">
    <div class="mf-product__gallery">
      {%- capture gallery_media -%}
        <div class="mf-product__slides" data-gallery>
          {%- if product.images.size == 0 -%}
            <button type="button" class="mf-product__slide is-active" data-index="0" aria-label="{{ product.title | escape }}">
              {% render 'media-placeholder', class: 'mf-product__photo', ratio: '4/5' %}
            </button>
          {%- endif -%}
          {%- for image in product.images -%}
            <button type="button" class="mf-product__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="{{ image.alt | escape }}">
              {{
                image
                | image_url: width: 1400
                | image_tag:
                  loading: forloop.first | default: 'lazy',
                  widths: '500,800,1100,1400',
                  sizes: '(min-width: 990px) 52vw, 96vw',
                  class: 'mf-product__photo',
                  alt: image.alt
              }}
            </button>
          {%- endfor -%}
        </div>

        {%- if settings.lens_enabled -%}
          <span class="mf-product__lens"
            data-lens-stage
            data-sketch="{{ sketch | image_url: width: 700 }}"
            data-macro="{{ macro | image_url: width: 700 }}"></span>
        {%- endif -%}

        {%- render 'product-hotspots', product: product -%}

        <button type="button" class="mf-detail-btn" data-open-detail>{{ 'products.product.detail' | t }}</button>
      {%- endcapture -%}

      {% render 'molfet-frame', content: gallery_media, tone: 'light' %}

      {%- assign points = product.metafields.molfet.detail_points.value -%}
      {%- if points != blank -%}
        <div class="mf-product__detail-rail">
          {%- for point in points limit: 3 -%}
            <button type="button" class="mf-detail-tile"
              data-title="{{ point.title | escape }}"
              data-text="{{ point.text | escape }}"
              data-macro="{{ point.macro_image | image_url: width: 500 }}"
              aria-pressed="false">
              <img src="{{ point.macro_image | image_url: width: 300 }}" alt="{{ point.title | escape }}" loading="lazy">
              <span>{{ point.title }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="mf-product__info">
      <p class="mf-eyebrow">{{ product.vendor | default: shop.name }} · {{ current_variant.sku }}</p>
      <h1>{{ product.title }}</h1>

      <div class="mf-product__price">
        {% render 'price', product: product %}
      </div>

      <div class="mf-product__desc">{{ product.description }}</div>

      <span class="mf-badge-outline">{{ 'brand.made_badge' | t }}</span>

      {%- comment -%} the picker reads this to resolve an option combination to a variant {%- endcomment -%}
      <script type="application/json" data-variant-json>
        {
          "variants": [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "available": {{ variant.available | json }},
                "price": {{ variant.price }},
                "priceFormatted": {{ variant.price | money | json }},
                "options": {{ variant.options | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "optionNames": {{ product.options | json }}
        }
      </script>

      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data"
        id="ProductForm" class="mf-product__form" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="&#10003;">
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- if product.compare_at_price > product.price -%}
          <p class="mf-product__was" data-price-was>{{ current_variant.compare_at_price | money }}</p>
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="mf-option">
              <legend>{{ option.name }}</legend>
              <div class="mf-option__values">
                {%- for value in option.values -%}
                  <label class="mf-option__chip">
                    <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <p class="mf-product__stock" data-variant-stock aria-live="polite"
          data-out="{{ 'products.product.sold_out' | t }}">
          {%- if current_variant.available -%}
            {{ 'products.product.in_stock' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </p>

        <div class="mf-product__buy">
          <div class="mf-qty" data-line="product">
            <button type="button" data-qty="-1" aria-label="{{ 'cart.decrease' | t }}">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
            <button type="button" data-qty="1" aria-label="{{ 'cart.increase' | t }}">+</button>
          </div>
          <button type="submit" name="add" class="mf-btn" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </button>
        </div>
      </form>

      <div class="mf-product__secondary">
        <button type="button" class="mf-btn mf-btn--ghost" data-open-size-guide>{{ 'products.product.size_guide' | t }}</button>
        <a class="mf-btn mf-btn--ghost" target="_blank" rel="noreferrer"
          href="https://wa.me/{{ settings.whatsapp_number }}?text={{ settings.whatsapp_message | append: ' ' | append: product.title | url_encode }}">
          {{ 'products.product.whatsapp' | t }}
        </a>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'accordion' -%}
            <details class="mf-accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="mf-accordion__body">{{ block.settings.body }}</div>
            </details>
          {%- when 'mix_it' -%}
            <div class="mf-product__mix" {{ block.shopify_attributes }}>
              <p class="mf-eyebrow">{{ 'mix.title' | t }}</p>
              <a class="mf-link" href="{{ routes.root_url }}pages/limitless-mix?look={{ product.id }}">{{ 'mix.cta_product' | t }}</a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if settings.sticky_atc -%}
  <div class="mf-sticky-atc" data-sticky-atc>
    <div>
      <p class="mf-sticky-atc__title">{{ product.title }}</p>
      <p class="mf-sticky-atc__price">{{ current_variant.price | money }}</p>
    </div>
    <button type="button" class="mf-btn" data-sticky-add>{{ 'products.product.add_to_cart' | t }}</button>
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & delivery" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "mix_it",
      "name": "Mix it module",
      "limit": 1,
      "settings": []
    },
    { "type": "@app" }
  ],
  "default": {
    "blocks": [
      { "type": "accordion" },
      { "type": "accordion" },
      { "type": "mix_it" }
    ]
  }
}
{% endschema %}
