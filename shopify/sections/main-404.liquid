{%- comment -%}
  404: "You found the edge of the map. Style doesn't have one."
{%- endcomment -%}
<section class="mf-404">
  {%- if settings.icon_on_cream != blank -%}
    <img src="{{ settings.icon_on_cream | image_url: width: 128 }}" alt="" width="64" height="64" loading="eager">
  {%- endif -%}
  <p class="mf-404__code">404</p>
  <h1>{{ 'general.404.title' | t }}</h1>
  <p class="mf-slogan">{{ settings.slogan | default: 'Style Without Limits' }}</p>
  <div class="mf-404__actions">
    <a class="mf-btn" href="{{ routes.all_products_collection_url }}">{{ 'general.404.cta' | t }}</a>
    <a class="mf-btn mf-btn--ghost" href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
  </div>
</section>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
