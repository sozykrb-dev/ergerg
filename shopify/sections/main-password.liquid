{%- comment -%}
  THE PASSWORD GATE — what a visitor sees on a store that is not open yet.

  Shopify posts `form.password` to `storefront_password`; on a wrong password it
  re-renders this template with `form.errors`, so the message has to be read from
  the form and not from a query string.

  The brand sits on one surface: the open circle, the wordmark, the slogan, and
  a single field. No header, no footer, no navigation — there is nowhere to go
  until the password is right.
{%- endcomment -%}
{%- capture cdn_base -%}{% render 'molfet-cdn' %}{%- endcapture -%}

<section class="mf-gate">
  <div class="mf-gate__inner">
    <div class="mf-gate__mark" aria-hidden="true">
      <svg viewBox="0 0 100 100" fill="none" class="mf-gate__ring">
        <path d="M 78.6 84.4 A 42 42 0 1 1 78.6 15.6"
          stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
        <path d="M 82 78 A 34 34 0 0 0 84.4 25"
          stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity=".7"/>
      </svg>
    </div>

    {%- if settings.wordmark_on_cream != blank -%}
      <img class="mf-gate__wordmark"
        src="{{ settings.wordmark_on_cream | image_url: width: 420 }}"
        alt="{{ shop.name }}" width="190" height="38">
    {%- else -%}
      <img class="mf-gate__wordmark"
        src="{{ cdn_base }}brand/molfet-wordmark.png"
        alt="{{ shop.name }}" width="190" height="38">
    {%- endif -%}

    <p class="mf-gate__slogan">{% render 'slogan' %}</p>

    <h1 class="mf-gate__title">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="mf-gate__intro">{{ shop.password_message }}</p>
    {%- else -%}
      <p class="mf-gate__intro">{{ 'password.intro' | t }}</p>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="mf-gate__error" role="alert">{{ 'password.error' | t }}</p>
      {%- endif -%}

      <label class="mf-gate__field">
        <span class="visually-hidden">{{ 'password.label' | t }}</span>
        <input type="password"
          name="password"
          id="Password"
          autocomplete="current-password"
          placeholder="{{ 'password.placeholder' | t }}"
          aria-describedby="mf-gate-submit"
          required
          {% if form.errors %}aria-invalid="true" autofocus{% endif %}>
        <button type="submit" id="mf-gate-submit" class="mf-gate__submit">
          <span>{{ 'password.submit' | t }}</span>
        </button>
      </label>
    {%- endform -%}

    {%- comment -%}
      The owner link goes to /admin, not to the customer account login: on a
      password-protected storefront /account/login is itself behind the gate and
      would bounce straight back to this page.
    {%- endcomment -%}
    <p class="mf-gate__admin">
      <a href="/admin">{{ 'password.admin' | t }}</a>
    </p>
  </div>

  <footer class="mf-gate__foot">
    <p class="mf-slogan">{{ 'password.powered_by' | t }} Shopify</p>
  </footer>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
