<footer class="mf-footer" data-tone="dark">
  <div class="mf-footer__inner">
    <div class="mf-footer__brand">
      {%- if settings.wordmark_on_brown != blank -%}
        <img src="{{ settings.wordmark_on_brown | image_url: width: 460 }}" alt="{{ shop.name }}" width="230" height="46" loading="lazy">
      {%- endif -%}
      <p class="mf-slogan">{% render 'slogan' %}</p>
      <p class="mf-footer__note">{{ section.settings.note }}</p>
    </div>

    <div class="mf-footer__columns">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="mf-footer__col" {{ block.shopify_attributes }}>
            <p class="mf-eyebrow">{{ block.settings.heading }}</p>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a class="mf-link" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="mf-footer__col">
        <p class="mf-eyebrow">{{ 'footer.contact' | t }}</p>
        <a class="mf-link" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noreferrer" dir="ltr">+{{ settings.whatsapp_number }}</a>
        <p class="mf-footer__note">{{ section.settings.location }}</p>
      </div>
    </div>
  </div>

  <div class="mf-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    <button type="button" class="mf-back-to-top" data-back-to-top aria-label="{{ 'accessibility.back_to_top' | t }}">
      {%- if settings.icon_on_cream != blank -%}
        <img src="{{ settings.icon_on_cream | image_url: width: 64 }}" alt="" width="18" height="18" loading="lazy">
      {%- else -%}
        {% render 'brand-fallback', type: 'mark' %}
      {%- endif -%}
    </button>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "note", "label": "Brand note", "default": "Egyptian fashion with an Italian design mindset." },
    { "type": "text", "id": "location", "label": "Location", "default": "Alexandria, Egypt · delivery nationwide" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [{ "type": "menu" }, { "type": "menu" }]
  }
}
{% endschema %}
