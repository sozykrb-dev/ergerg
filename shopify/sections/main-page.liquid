<section class="mf-page">
  <header class="mf-page__head">
    <p class="mf-eyebrow">{{ page.metafields.molfet.eyebrow | default: 'MOLFET' }}</p>
    <h1>{{ page.title }}</h1>
    <p class="mf-slogan">{% render 'slogan' %}</p>
  </header>
  <div class="mf-page__body">{{ page.content }}</div>
</section>

{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
