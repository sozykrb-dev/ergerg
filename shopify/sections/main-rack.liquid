{%- comment -%}
  RACK VIEW — the collection as a clothing rail.

  Only garments hang here: tops, bottoms and outerwear from the collection the
  merchant picks (accessories are filtered out on purpose). Each piece hangs from
  a drawn hanger on a maroon rail; every garment turns on its hanger — drag it,
  press the turn button, or double-click. The rail itself is draggable and
  arrow-key scrollable, and the turn direction flips in Arabic so dragging feels
  natural in RTL. Reduced motion: no sway, the turn still happens on request.

  Data: product.metafields.molfet.cutout (transparent PNG/WEBP) for the turning
  layer, the featured image otherwise.
{%- endcomment -%}
{%- assign rack_collection = collections[section.settings.collection] -%}
{%- assign garments = rack_collection.products | where: 'available', true -%}

<section class="mf-rack-page" data-rack>
  <header class="mf-rack-page__head">
    <nav class="mf-breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><span>{{ 'rack.title' | t }}</span>
    </nav>
    <p class="mf-eyebrow">{{ 'rack.eyebrow' | t }}</p>
    <h1>{{ section.settings.heading | default: 'Everything on the rail' }}</h1>
    <p class="mf-rack-page__intro">{{ 'rack.intro' | t }}</p>
  </header>

  <div class="mf-rack" data-rack-sway>
    <span class="mf-rack__post mf-rack__post--start" aria-hidden="true"></span>
    <span class="mf-rack__post mf-rack__post--end" aria-hidden="true"></span>
    <span class="mf-rack__bar" aria-hidden="true"></span>

    <div class="mf-rack__scroller" data-rack-scroller tabindex="0" role="list" aria-label="{{ 'rack.rail' | t }}">
      <ul class="mf-rack__items">
        {%- for product in garments -%}
          {%- assign slot = product.metafields.molfet.slot.value | default: 'top' -%}
          {%- if slot == 'accessory' -%}{%- continue -%}{%- endif -%}

          {%- assign cutout = product.metafields.molfet.cutout -%}
          <li class="mf-rack-item" style="--sway-delay: {% cycle '0s', '0.35s', '0.7s', '1.05s', '1.4s', '1.75s' %};" data-slot="{{ slot }}">
            <div class="mf-rack-item__hang">
              {%- comment -%} an open ring hook — the logo's gap — the rail runs through it {%- endcomment -%}
              <svg class="mf-rack-item__hanger" viewBox="0 0 120 100" fill="none" aria-hidden="true">
                <path d="M70.3 23.8 A11 11 0 1 0 63.8 30.3"
                  stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                <path d="M60 31 V42 L14 76 H106 L60 42"
                  stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16 76 H104" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
              </svg>

              <div class="mf-rack-item__stage" data-rack-stage
                role="group" aria-label="{{ 'rack.turn' | t: title: product.title }}">
                <div class="mf-rack-item__turn" data-rack-turn>
                  {%- if cutout != blank or product.featured_image != blank -%}
                    <img
                      src="{{ cutout | default: product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.title | escape }}"
                      width="300" height="400"
                      loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                      draggable="false">
                  {%- else -%}
                    {% render 'media-placeholder', class: 'mf-rack-item__img', ratio: '3/4' %}
                  {%- endif -%}
                </div>
              </div>

              <button type="button" class="mf-rack-item__spin" data-rack-spin
                aria-label="{{ 'rack.turn_around' | t: title: product.title }}">
                <svg viewBox="0 0 20 20" width="14" height="14" fill="none" aria-hidden="true">
                  <path d="M16 10a6 6 0 1 1-2-4.5M16 3v3.5h-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>

            <div class="mf-rack-item__label">
              <a href="{{ product.url }}" class="mf-rack-item__title">{{ product.title }}</a>
              <div class="mf-rack-item__meta">
                <span>{{ product.price | money }}</span>
                {%- if product.variants.size > 0 -%}
                  <span class="mf-rack-item__sizes">{{ product.variants | map: 'title' | join: ' · ' | truncate: 26, '' }}</span>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- else -%}
          <li class="mf-rack__empty">{{ 'rack.empty' | t }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <p class="mf-rack-page__hint">{{ 'rack.hint' | t }}</p>
</section>

{% schema %}
{
  "name": "Rack view",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection to hang" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything on the rail" },
    { "type": "paragraph", "content": "Only clothing hangs on the rail: products tagged with the molfet.slot metafield top, bottom or outerwear. Accessories are skipped." }
  ],
  "presets": [{ "name": "Rack view" }]
}
{% endschema %}
