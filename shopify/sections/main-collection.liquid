{%- comment -%}
  Collection: filters with Shopify Search & Discovery, framed product cards.
{%- endcomment -%}
<section class="mf-collection">
  <header class="mf-collection__head">
    <nav class="mf-breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><span>{{ collection.title }}</span>
    </nav>
    <h1>{{ collection.title }}</h1>
    <p class="mf-collection__count">{{ collection.products_count }} {{ 'collections.pieces' | t }}</p>

    {%- comment -%}
      The two views the brand is built on: the grid, and the rail. Both live on
      this page, so switching is instant and needs no second template, no extra
      page to create, and no round trip. The choice is remembered per visitor.
    {%- endcomment -%}
    <div class="mf-viewswitch" role="group" aria-label="{{ 'collections.view' | t }}">
      <button type="button" class="mf-viewswitch__btn is-active"
        data-view-toggle="grid" aria-pressed="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
          <path d="M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z" stroke="currentColor" stroke-width="1.3"/>
        </svg>
        <span>{{ 'collections.view_grid' | t }}</span>
      </button>
      <button type="button" class="mf-viewswitch__btn"
        data-view-toggle="rack" aria-pressed="false">
        <svg viewBox="0 0 20 20" width="14" height="14" fill="none" aria-hidden="true">
          <path d="M3 5h14M5 5v2.5c0 .8.6 1.5 1.4 1.5h7.2c.8 0 1.4-.7 1.4-1.5V5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M7 9v7M13 9v7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.55"/>
        </svg>
        <span>{{ 'collections.view_rack' | t }}</span>
      </button>
    </div>
    {%- if collection.description != blank -%}<div class="mf-collection__desc">{{ collection.description }}</div>{%- endif -%}
  </header>

  <div class="mf-collection__layout {% if section.settings.enable_filtering %}has-filters{% endif %}">
    {%- if section.settings.enable_filtering -%}
      <aside class="mf-filters" aria-label="{{ 'collections.filters' | t }}" data-view-panel="filters">
        <form id="FacetFiltersForm">
          {%- for filter in collection.filters -%}
            <details class="mf-filter" open>
              <summary>{{ filter.label }}</summary>
              <div class="mf-filter__body">
                {%- case filter.type -%}
                  {%- when 'boolean', 'list' -%}
                    {%- for value in filter.values -%}
                      <label class="mf-filter__option">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                          {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span>{{ value.label }}</span>
                        <em>{{ value.count }}</em>
                      </label>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    <div class="mf-filter__price">
                      <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ 'collections.from' | t }}">
                      <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ 'collections.to' | t }}">
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
          <noscript><button type="submit" class="mf-btn">{{ 'collections.apply' | t }}</button></noscript>
        </form>
      </aside>
    {%- endif -%}

    <div class="mf-collection__results" data-view-panel="grid">
      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="mf-product-grid">
          {%- for product in collection.products -%}
            {% render 'molfet-product-card', product: product %}
          {%- else -%}
            <p class="mf-collection__empty">{{ 'collections.empty' | t }}</p>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="mf-pagination" aria-label="{{ 'accessibility.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    {%- comment -%}
      The rail, on the same collection. It is hidden until asked for, and the
      products come from the collection on screen, so a filtered or paginated
      view still hangs the pieces the visitor is looking at.
    {%- endcomment -%}
    <div class="mf-collection__results mf-collection__results--rack"
      data-view-panel="rack" data-rack hidden>
      {% render 'molfet-rack-rail', products: collection.products %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 32, "step": 4, "default": 16 },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering (Search & Discovery)", "default": true }
  ]
}
{% endschema %}
