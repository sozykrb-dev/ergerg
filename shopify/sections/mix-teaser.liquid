{%- comment -%}
  Limitless Mix teaser: four stacked cut-outs inside a frame.

  With no images uploaded it stacks the four concept cut-outs, so the module
  keeps its meaning instead of collapsing to an empty frame.
{%- endcomment -%}
{%- capture cdn_base -%}{% render 'molfet-cdn' %}{%- endcapture -%}
{%- assign concept_cutouts = 'img/products/overshirt-maroon-cut.webp,img/products/tee-black-cut.webp,img/products/pants-gray-cut.webp,img/products/tote-cream-cut.webp' | split: ',' -%}
<section class="mf-mix-teaser" data-tone="dark">
  <div class="mf-mix-teaser__inner">
    <div>
      <p class="mf-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a class="mf-btn mf-btn--cream" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}{% render 'icon-arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="mf-mix-teaser__media">
      {%- capture mix_media -%}
        <span class="mf-mix-teaser__stack">
          {%- comment -%}
            Each block may carry its own cut-out. When it does not, the matching
            concept cut-out fills the same slot, so a fresh install still stacks
            four pieces rather than collapsing to an empty frame.
          {%- endcomment -%}
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt | escape }}" loading="lazy">
              {%- else -%}
                {%- assign slot = forloop.index0 -%}
                <img src="{{ cdn_base }}{{ concept_cutouts[slot] }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for path in concept_cutouts limit: 4 -%}
              <img src="{{ cdn_base }}{{ path }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
            {%- endfor -%}
          {%- endif -%}
        </span>
      {%- endcapture -%}
      {% render 'molfet-frame', content: mix_media, tone: 'dark' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Limitless Mix teaser",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limitless Mix" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One piece per category. One look, added in one tap." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick a top, a bottom, an outer layer and an accessory." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build a look" },
    { "type": "url", "id": "link", "label": "Link to the Mix page" }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Piece cut-out",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Cut-out" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [{ "name": "Limitless Mix teaser", "blocks": [{ "type": "piece" }, { "type": "piece" }, { "type": "piece" }, { "type": "piece" }] }]
}
{% endschema %}
