<section class="mf-about" data-tone="light">
  <header class="mf-about__head">
    <p class="mf-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="mf-slogan">{% render 'slogan' %}</p>
    <div class="mf-about__statement">{{ section.settings.statement }}</div>
  </header>

  <div class="mf-about__pillars">
    {%- for block in section.blocks -%}
      <article class="mf-about__pillar" {{ block.shopify_attributes }}>
        <span class="mf-eyebrow">{{ forloop.index | prepend: '0' }}</span>
        <h2>{{ block.settings.heading }}</h2>
        <p>{{ block.settings.body }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The brand" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A name, a slogan and an open circle." },
    { "type": "richtext", "id": "statement", "label": "Brand statement" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The circle never closes" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [{ "name": "About", "blocks": [{ "type": "pillar" }, { "type": "pillar" }, { "type": "pillar" }] }]
}
{% endschema %}
