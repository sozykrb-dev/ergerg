{%- comment -%}
  Hero: the frame-break image, the slogan and one button.
  The subject (a shoulder, a sleeve, a shoe, a bag) crosses the frame line
  using a cut-out layer and negative margins.
{%- endcomment -%}
<section class="mf-hero" data-tone="light">
  <div class="mf-hero__inner">
    <div class="mf-hero__copy">
      <p class="mf-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="mf-hero__title">{{ section.settings.heading }}</h1>
      <p class="mf-slogan mf-hero__slogan">{% render 'slogan' %}</p>
      <p class="mf-hero__text">{{ section.settings.text }}</p>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="mf-btn">{{ section.settings.cta_label }}{% render 'icon-arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="mf-hero__media">
      {%- capture hero_media -%}
        <span class="mf-hero__surface">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600,900,1200',
              sizes: '(min-width: 990px) 46vw, 92vw',
              class: 'mf-hero__photo',
              alt: section.settings.image.alt
          }}
          {%- if section.settings.cutout != blank -%}
            <img class="mf-hero__cutout mf-break"
              src="{{ section.settings.cutout | image_url: width: 1200 }}"
              srcset="{{ section.settings.cutout | image_url: width: 600 }} 600w, {{ section.settings.cutout | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 46vw, 92vw"
              alt="" aria-hidden="true" loading="eager">
          {%- endif -%}
        </span>
      {%- endcapture -%}

      {% render 'molfet-frame', content: hero_media, tone: 'light', gap: 38 %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero — Break the Frame",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Italian mindset · Egyptian hands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Break the frame." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every image sits inside a thin frame — the limit. The cut, the fabric and the detail step out of it." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Photograph on a solid brand surface" },
    { "type": "image_picker", "id": "cutout", "label": "Cut-out with transparent background" }
  ],
  "presets": [{ "name": "Hero — Break the Frame" }]
}
{% endschema %}
