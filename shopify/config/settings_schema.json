[
  {
    "name": "Brand",
    "settings": [
      {
        "type": "paragraph",
        "content": "The three brand colours, locked. Every other shade in the theme is a color-mix() of these values. No pure white, no pure black, no other hues."
      },
      {
        "type": "color",
        "id": "color_maroon",
        "label": "Maroon — main",
        "default": "#711518"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream — surfaces",
        "default": "#FAED99"
      },
      {
        "type": "color",
        "id": "color_brown",
        "label": "Dark brown — contrast",
        "default": "#321E19"
      },
      {
        "type": "header",
        "content": "The four official lockups"
      },
      {
        "type": "paragraph",
        "content": "Upload the supplied PNG/SVG files. Never redraw, stretch, recolor, outline or shadow them. Clear space on every side equals the width of the O ring. Never place the logo on a photo without a solid colour overlay."
      },
      {
        "type": "image_picker",
        "id": "wordmark_on_cream",
        "label": "Maroon wordmark + slogan (on cream)"
      },
      {
        "type": "image_picker",
        "id": "wordmark_on_brown",
        "label": "Cream wordmark + slogan (on dark brown)"
      },
      {
        "type": "image_picker",
        "id": "icon_on_maroon",
        "label": "Cream brush-circle icon (on maroon) — favicon / app icon",
        "info": "Square export for the app icon / social avatar. The browser tab icon is the cream lockup above."
      },
      {
        "type": "image_picker",
        "id": "icon_on_cream",
        "label": "Maroon brush-circle icon (on cream)"
      },
      {
        "type": "header",
        "content": "Slogan"
      },
      {
        "type": "paragraph",
        "content": "Fixed wording: “Style Without Limits”. Never altered, never translated inside the lockup. Arabic keeps the Latin slogan in the lockup; the Arabic line below is for body copy if the client approves it."
      },
      {
        "type": "text",
        "id": "slogan",
        "label": "Slogan",
        "default": "Style Without Limits",
        "info": "Set in weight 300 with about 0.25em letter spacing. Appears in the hero, announcement bar, footer, loader, empty cart and 404."
      },
      {
        "type": "text",
        "id": "slogan_ar",
        "label": "Slogan (Arabic body copy, optional)",
        "default": "أسلوب بلا حدود"
      }
    ]
  },
  {
    "name": "Colour schemes",
    "settings": [
      {
        "type": "paragraph",
        "content": "Three schemes, named after the three colours. Every section that offers a colour scheme uses only these. Maroon text never sits on brown (1.4:1)."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "label": "Cream",
            "media": "image",
            "settings": {
              "background": "#FAED99",
              "background_gradient": "",
              "text": "#321E19",
              "button": "#711518",
              "button_label": "#FAED99",
              "secondary_button_label": "#711518",
              "shadow": "#321E19"
            }
          },
          {
            "label": "Maroon",
            "media": "image",
            "settings": {
              "background": "#711518",
              "background_gradient": "",
              "text": "#FAED99",
              "button": "#FAED99",
              "button_label": "#711518",
              "secondary_button_label": "#FAED99",
              "shadow": "#321E19"
            }
          },
          {
            "label": "Brown",
            "media": "image",
            "settings": {
              "background": "#321E19",
              "background_gradient": "",
              "text": "#FAED99",
              "button": "#FAED99",
              "button_label": "#321E19",
              "secondary_button_label": "#FAED99",
              "shadow": "#711518"
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Concept — Break the Frame",
    "settings": [
      {
        "type": "checkbox",
        "id": "lens_enabled",
        "label": "Enable the Lens",
        "default": true,
        "info": "Cursor becomes the brush circle; over a product it opens to 160px and reveals the Italian sketch and the macro fabric."
      },
      {
        "type": "range",
        "id": "lens_size",
        "label": "Lens diameter",
        "min": 120,
        "max": 220,
        "step": 10,
        "unit": "px",
        "default": 160
      },
      {
        "type": "range",
        "id": "frame_break_px",
        "label": "How far the subject crosses the frame",
        "min": 8,
        "max": 16,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "frame_gap_px",
        "label": "Frame opening (bottom-right)",
        "min": 18,
        "max": 56,
        "step": 2,
        "unit": "px",
        "default": 30
      },
      {
        "type": "text",
        "id": "lens_caption",
        "label": "Lens caption",
        "default": "Italian mindset. Egyptian hands."
      }
    ]
  },
  {
    "name": "Cart and shipping",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free-shipping threshold (EGP)",
        "default": 2900
      },
      {
        "type": "number",
        "id": "look_discount_percent",
        "label": "Automatic discount for looks of 3+ pieces (%)",
        "default": 10,
        "info": "The discount itself is configured in Shopify (Discounts → Automatic). This number only drives the message."
      },
      {
        "type": "checkbox",
        "id": "sticky_atc",
        "label": "Sticky add-to-cart on mobile",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_discount_field",
        "label": "Show the discount-code field in the cart",
        "default": true
      }
    ]
  },
  {
    "name": "Contact",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number (digits, with country code)",
        "default": "201012345678"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "Default WhatsApp order message",
        "default": "Hello MOLFET, I would like to order:"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Jost (headings, 500–600; slogan, 300) and Jost/Inter for body are loaded from Google Fonts with font-display: swap; the heading face is preloaded in layout/theme.liquid. Arabic uses Cairo or Tajawal with matching weights."
      }
    ]
  },
  {
    "name": "theme_info",
    "theme_name": "MOLFET — Break the Frame",
    "theme_version": "1.0.0",
    "theme_author": "MOLFET",
    "theme_documentation_url": "https://molfet.com/pages/theme-guide",
    "theme_support_url": "https://molfet.com/pages/contact"
  }
]
