<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_cream }}">

    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t }} {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" href="{{ settings.icon_on_cream | image_url: width: 96 }}">

    {%- comment -%} Typography: font-display: swap, heading face preloaded {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cairo:wght@300;400;500;600&display=swap"
      media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cairo:wght@300;400;500;600&display=swap">
    </noscript>

    {{ 'molfet.css' | asset_url | stylesheet_tag }}
    <script>
      document.documentElement.classList.add('js');
      window.MOLFET_LENS_SIZE = {{ settings.lens_size | default: 160 }};
      window.MOLFET_LOOK_DISCOUNT = {{ settings.look_discount_percent | default: 0 }};
      window.MOLFET_MONEY_FORMAT = {{ shop.money_format | json }};
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = { root: {{ routes.root_url | json }} };
    </script>
    <script src="{{ 'molfet.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="mf-body template-{{ template.name | handle }}">
    <a class="mf-skip" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% render 'cart-drawer' %}
    {% render 'lens-cursor' %}
    {% render 'page-loader' %}
    {% render 'size-guide' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>
  </body>
</html>
